<style>
  .lumu-cats { padding: 60px 0; background: #F7F5FC; }
  .lumu-cats__title {
    text-align: center; margin-bottom: 40px; position: relative; padding-bottom: 16px;
  }
  .lumu-cats__title h2 {
    font-size: 3rem; font-weight: 800; color: #121212; letter-spacing: -0.02em;
  }
  .lumu-cats__title::after {
    content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 50px; height: 3px; background: linear-gradient(90deg, #8577C7, #a491f0); border-radius: 3px;
  }
  .lumu-cats__grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
    max-width: 1200px; margin: 0 auto; padding: 0 20px;
  }
  .lumu-cat-card {
    background: white; border-radius: 16px; overflow: hidden;
    text-decoration: none; color: inherit;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    display: flex; flex-direction: column;
  }
  .lumu-cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(133, 119, 199, 0.18);
  }
  .lumu-cat-card__img {
    width: 100%; aspect-ratio: 4/3; object-fit: cover;
    transition: transform 0.5s ease;
  }
  .lumu-cat-card:hover .lumu-cat-card__img { transform: scale(1.05); }
  .lumu-cat-card__img-wrap { overflow: hidden; position: relative; }
  .lumu-cat-card__body { padding: 20px; text-align: center; }
  .lumu-cat-card__icon {
    width: 40px; height: 40px; margin: 0 auto 10px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(133, 119, 199, 0.1); border-radius: 12px; color: #8577C7;
  }
  .lumu-cat-card__icon svg { width: 22px; height: 22px; }
  .lumu-cat-card__name { font-size: 1.6rem; font-weight: 700; margin-bottom: 4px; color: #121212; }
  .lumu-cat-card__desc { font-size: 1.3rem; color: #666; line-height: 1.5; margin-bottom: 10px; }
  .lumu-cat-card__link {
    font-size: 1.3rem; color: #8577C7; font-weight: 600;
    display: inline-flex; align-items: center; gap: 4px;
    transition: gap 0.3s ease;
  }
  .lumu-cat-card:hover .lumu-cat-card__link { gap: 8px; }
  .lumu-cats__cta { text-align: center; margin-top: 40px; }
  .lumu-cats__cta a {
    display: inline-block; padding: 14px 36px;
    background: #8577C7; color: white; border-radius: 8px;
    font-weight: 700; font-size: 1.5rem; text-decoration: none;
    transition: all 0.3s ease; letter-spacing: 0.03em;
  }
  .lumu-cats__cta a:hover {
    background: #6153a7; transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(133,119,199,0.4);
  }
  @media (max-width: 989px) { .lumu-cats__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 549px) {
    .lumu-cats__grid { grid-template-columns: 1fr; gap: 16px; }
    .lumu-cat-card__body { padding: 14px; }
    .lumu-cat-card__name { font-size: 1.4rem; }
    .lumu-cats__title h2 { font-size: 2.2rem; }
  }
</style>

<div class="lumu-cats">
  <div class="lumu-cats__title">
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="lumu-cats__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection_obj = block.settings.collection
          assign card_url = collection_obj.url | default: '#'
          assign card_title = block.settings.title | default: collection_obj.title | default: 'Category'
          assign card_desc = block.settings.description | default: collection_obj.description | strip_html | truncatewords: 8 | default: 'Shop our custom collection'
          
          if block.settings.image != blank
            assign card_image_obj = block.settings.image
            assign card_img = card_image_obj | image_url: width: 600
          elsif collection_obj.featured_image != blank
            assign card_image_obj = collection_obj.featured_image
            assign card_img = card_image_obj | image_url: width: 600
          else
            assign card_image_obj = blank
            assign card_img = blank
          endif
        -%}
        <a href="{{ card_url }}" class="lumu-cat-card" {{ block.shopify_attributes }}>
          <div class="lumu-cat-card__img-wrap">
            {%- if card_img != blank -%}
              <img src="{{ card_img }}" alt="{{ card_title | escape }}" class="lumu-cat-card__img" loading="lazy" width="{{ card_image_obj.width }}" height="{{ card_image_obj.height }}">
            {%- else -%}
              <div class="lumu-cat-card__img" style="aspect-ratio: 4/3; background: #e2e8f0; display: flex; align-items: center; justify-content: center; color: #a0aec0; font-weight: 500;">
                No Image
              </div>
            {%- endif -%}
            {% render 'lumu-brand-watermark', size: 'card' %}
          </div>
          <div class="lumu-cat-card__body">
            <div class="lumu-cat-card__icon">
              {%- case block.settings.icon -%}
                {%- when 'tech' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                {%- when 'home' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg>
                {%- when 'beauty' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                {%- when 'fashion' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4c0 2.21-1.79 4-4 4S8 8.21 8 6a4 4 0 014-4zM12 14c-4 0-8 2-8 4v2h16v-2c0-2-4-4-8-4z"/></svg>
                {%- when 'trending' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
                {%- when 'deals' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              {%- endcase -%}
            </div>
            <div class="lumu-cat-card__name">{{ card_title }}</div>
            <div class="lumu-cat-card__desc">{{ card_desc }}</div>
            <span class="lumu-cat-card__link">Shop Now →</span>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      <!-- Tech & Smart Gadgets -->
      <a href="{{ routes.collections_url }}/tech-smart-gadgets" class="lumu-cat-card">
        <div class="lumu-cat-card__img-wrap">
          <img src="{{ 'lumu-hero-2.png' | asset_url }}" alt="Tech & Smart Gadgets" class="lumu-cat-card__img" loading="lazy" width="600" height="450">
          {% render 'lumu-brand-watermark', size: 'card' %}
        </div>
        <div class="lumu-cat-card__body">
          <div class="lumu-cat-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          </div>
          <div class="lumu-cat-card__name">Tech & Gadgets</div>
          <div class="lumu-cat-card__desc">Smart accessories & viral tech limits</div>
          <span class="lumu-cat-card__link">Shop Now →</span>
        </div>
      </a>

      <!-- Home & Kitchen Essentials -->
      <a href="{{ routes.collections_url }}/home-kitchen-essentials" class="lumu-cat-card">
        <div class="lumu-cat-card__img-wrap">
          <img src="{{ 'lumu_curated_excellence.png' | asset_url }}" alt="Home & Kitchen Essentials" class="lumu-cat-card__img" loading="lazy" width="600" height="450">
          {% render 'lumu-brand-watermark', size: 'card' %}
        </div>
        <div class="lumu-cat-card__body">
          <div class="lumu-cat-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg>
          </div>
          <div class="lumu-cat-card__name">Home & Kitchen</div>
          <div class="lumu-cat-card__desc">Aesthetic decor & smart home tools</div>
          <span class="lumu-cat-card__link">Shop Now →</span>
        </div>
      </a>

      <!-- Health & Beauty -->
      <a href="{{ routes.collections_url }}/health-beauty" class="lumu-cat-card">
        <div class="lumu-cat-card__img-wrap">
          <img src="{{ 'lumu-hero-1.png' | asset_url }}" alt="Health & Beauty" class="lumu-cat-card__img" loading="lazy" width="600" height="450">
          {% render 'lumu-brand-watermark', size: 'card' %}
        </div>
        <div class="lumu-cat-card__body">
          <div class="lumu-cat-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <div class="lumu-cat-card__name">Health & Beauty</div>
          <div class="lumu-cat-card__desc">Premium self-care & skincare essentials</div>
          <span class="lumu-cat-card__link">Shop Now →</span>
        </div>
      </a>

      <!-- Premium Fashion -->
      <a href="{{ routes.collections_url }}/premium-fashion-accessories" class="lumu-cat-card">
        <div class="lumu-cat-card__img-wrap">
          <img src="{{ 'lumu-cat-women.png' | asset_url }}" alt="Premium Fashion Accessories" class="lumu-cat-card__img" loading="lazy" width="600" height="450">
          {% render 'lumu-brand-watermark', size: 'card' %}
        </div>
        <div class="lumu-cat-card__body">
          <div class="lumu-cat-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 2a4 4 0 014 4c0 2.21-1.79 4-4 4S8 8.21 8 6a4 4 0 014-4zM12 14c-4 0-8 2-8 4v2h16v-2c0-2-4-4-8-4z"/></svg>
          </div>
          <div class="lumu-cat-card__name">Fashion Accessories</div>
          <div class="lumu-cat-card__desc">Elegant jewelry, watches & styling gear</div>
          <span class="lumu-cat-card__link">Shop Now →</span>
        </div>
      </a>

      <!-- Trending & Viral Finds -->
      <a href="{{ routes.collections_url }}/trending-viral-finds" class="lumu-cat-card">
        <div class="lumu-cat-card__img-wrap">
          <img src="{{ 'lumu-cat-men.png' | asset_url }}" alt="Trending & Viral Finds" class="lumu-cat-card__img" loading="lazy" width="600" height="450">
          {% render 'lumu-brand-watermark', size: 'card' %}
        </div>
        <div class="lumu-cat-card__body">
          <div class="lumu-cat-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
          </div>
          <div class="lumu-cat-card__name">Trending & Viral</div>
          <div class="lumu-cat-card__desc">TikTok & Insta famous must-haves</div>
          <span class="lumu-cat-card__link">Shop Now →</span>
        </div>
      </a>

      <!-- Best Sellers (Flash Deals) -->
      <a href="{{ routes.all_products_collection_url }}" class="lumu-cat-card">
        <div class="lumu-cat-card__img-wrap">
          <img src="{{ 'lumu-hero-3.png' | asset_url }}" alt="Flash Deals" class="lumu-cat-card__img" loading="lazy" width="600" height="450">
          {% render 'lumu-brand-watermark', size: 'card' %}
        </div>
        <div class="lumu-cat-card__body">
          <div class="lumu-cat-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div class="lumu-cat-card__name">Flash Deals</div>
          <div class="lumu-cat-card__desc">Limited-time offers on top products</div>
          <span class="lumu-cat-card__link">Shop Now →</span>
        </div>
      </a>
    {%- endif -%}
  </div>
  {%- if section.settings.show_cta -%}
    <div class="lumu-cats__cta">
      <a href="{{ section.settings.cta_link | default: routes.collections_url }}">{{ section.settings.cta_label }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Lumu Categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop By Category"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show 'Browse All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Browse All Departments"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image Override (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override (Optional)"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description Override (Optional)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Category Icon",
          "options": [
            { "value": "tech", "label": "Tech & Gadgets" },
            { "value": "home", "label": "Home & Kitchen" },
            { "value": "beauty", "label": "Health & Beauty" },
            { "value": "fashion", "label": "Fashion Accessories" },
            { "value": "trending", "label": "Trending & Viral" },
            { "value": "deals", "label": "Flash Deals" }
          ],
          "default": "tech"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumu Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Tech & Gadgets",
            "description": "Smart accessories & viral tech finds",
            "icon": "tech"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Home & Kitchen",
            "description": "Aesthetic decor & smart home tools",
            "icon": "home"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Health & Beauty",
            "description": "Premium self-care & skincare essentials",
            "icon": "beauty"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Fashion Accessories",
            "description": "Elegant jewelry, watches & styling gear",
            "icon": "fashion"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Trending & Viral",
            "description": "TikTok & Insta famous must-haves",
            "icon": "trending"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Flash Deals",
            "description": "Limited-time offers on top products",
            "icon": "deals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
