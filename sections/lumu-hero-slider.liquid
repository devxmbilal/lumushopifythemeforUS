{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<style>
  .lumu-slider { position: relative; overflow: hidden; border-radius: 0; }
  .lumu-slider__track { display: flex; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
  .lumu-slider__slide {
    min-width: 100%; position: relative;
    display: flex; align-items: center; justify-content: center;
    min-height: 520px; background-size: cover; background-position: center;
  }
  .lumu-slider__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(10,10,25,0.78) 0%, rgba(60,50,110,0.55) 100%);
  }
  .lumu-slider__content {
    position: relative; z-index: 2; text-align: center;
    color: white; max-width: 700px; padding: 40px 20px;
  }
  .lumu-slider__content h2 {
    font-size: 4.6rem; font-weight: 800; margin-bottom: 18px;
    line-height: 1.1; letter-spacing: -0.03em;
    color: #ffffff;
    text-shadow: 0 3px 30px rgba(0,0,0,0.6), 0 1px 4px rgba(0,0,0,0.4);
  }
  .lumu-slider__content p {
    font-size: 1.7rem; margin-bottom: 28px; opacity: 1;
    line-height: 1.6; color: #ffffff;
    text-shadow: 0 2px 15px rgba(0,0,0,0.5), 0 1px 3px rgba(0,0,0,0.3);
  }
  .lumu-slider__btn {
    display: inline-block; padding: 14px 36px;
    background: white; color: #1a1a2e; border-radius: 8px;
    font-weight: 700; font-size: 1.5rem; text-decoration: none;
    transition: all 0.3s ease; letter-spacing: 0.03em;
  }
  .lumu-slider__btn:hover {
    background: #8577C7; color: white;
    transform: translateY(-2px); box-shadow: 0 6px 20px rgba(133,119,199,0.4);
  }
  .lumu-slider__btn--outline {
    background: transparent; border: 2px solid white; color: white; margin-left: 12px;
  }
  .lumu-slider__btn--outline:hover {
    background: white; color: #1a1a2e;
  }
  .lumu-slider__nav {
    position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 10px; z-index: 3;
  }
  .lumu-slider__dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: rgba(255,255,255,0.5); border: none; cursor: pointer;
    transition: all 0.3s ease;
  }
  .lumu-slider__dot.active { background: white; transform: scale(1.2); }
  .lumu-slider__arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 3; background: rgba(255,255,255,0.2); border: none;
    color: white; width: 48px; height: 48px; border-radius: 50%;
    font-size: 20px; cursor: pointer; transition: all 0.3s ease;
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(4px);
  }
  .lumu-slider__arrow:hover { background: rgba(255,255,255,0.4); }
  .lumu-slider__arrow--prev { left: 20px; }
  .lumu-slider__arrow--next { right: 20px; }

  @media (max-width: 749px) {
    .lumu-slider__slide { min-height: 420px; }
    .lumu-slider__content { padding: 30px 15px; width: 100%; }
    .lumu-slider__content h2 { font-size: 2.22rem; margin-bottom: 12px; }
    .lumu-slider__content p { font-size: 1.35rem; margin-bottom: 20px; }
    .lumu-slider__btn { padding: 10px 20px; font-size: 1.25rem; min-width: 140px; }
    .lumu-slider__btn--outline { margin-left: 0; margin-top: 8px; }
    .lumu-slider__arrow { width: 34px; height: 34px; font-size: 14px; }
  }
</style>

<div class="lumu-slider" id="LumuSlider">
  <div class="lumu-slider__track" id="LumuSliderTrack">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="lumu-slider__slide" style="background-image: url('{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1920 }}{% else %}{{ 'lumu-hero-' | append: forloop.index | append: '.png' | asset_url }}{% endif %}');" {{ block.shopify_attributes }}>
          <div class="lumu-slider__overlay"></div>
          <div class="lumu-slider__content">
            <h2>{{ block.settings.heading }}</h2>
            <p>{{ block.settings.text }}</p>
            <div>
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="lumu-slider__btn">{{ block.settings.button_label }}</a>
              {%- endif -%}
              {%- if block.settings.secondary_button_label != blank -%}
                <a href="{{ block.settings.secondary_button_link | default: routes.collections_url }}" class="lumu-slider__btn lumu-slider__btn--outline">{{ block.settings.secondary_button_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Fallback static slides -->
      <div class="lumu-slider__slide" style="background-image: url('{{ 'lumu-hero-1.png' | asset_url }}');">
        <div class="lumu-slider__overlay"></div>
        <div class="lumu-slider__content">
          <h2>Your One-Stop Shop for <em>Everything</em></h2>
          <p>From fashion to electronics, home essentials to beauty — shop 100+ categories with free delivery across the United States.</p>
          <div>
            <a href="{{ routes.all_products_collection_url }}" class="lumu-slider__btn">Shop Now</a>
            <a href="{{ routes.collections_url }}" class="lumu-slider__btn lumu-slider__btn--outline">Browse Collections</a>
          </div>
        </div>
      </div>
      <div class="lumu-slider__slide" style="background-image: url('{{ 'lumu-hero-2.png' | asset_url }}');">
        <div class="lumu-slider__overlay"></div>
        <div class="lumu-slider__content">
          <h2>Latest Tech & Gadgets</h2>
          <p>Discover premium earbuds, smartwatches, chargers & more at prices you'll love. All 100% authentic.</p>
          <div>
            <a href="{{ routes.all_products_collection_url }}" class="lumu-slider__btn">Shop Electronics</a>
          </div>
        </div>
      </div>
      <div class="lumu-slider__slide" style="background-image: url('{{ 'lumu-hero-3.png' | asset_url }}');">
        <div class="lumu-slider__overlay"></div>
        <div class="lumu-slider__content">
          <h2>Transform Your Space</h2>
          <p>Premium home & kitchen essentials delivered to your door. Bedding, décor, cookware & more.</p>
          <div>
            <a href="{{ routes.all_products_collection_url }}" class="lumu-slider__btn">Shop Home</a>
            <a href="{{ routes.collections_url }}" class="lumu-slider__btn lumu-slider__btn--outline">View All</a>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- assign slide_count = section.blocks.size -%}
  {%- if slide_count == 0 -%}{%- assign slide_count = 3 -%}{%- endif -%}
  {%- if slide_count > 1 -%}
    <button class="lumu-slider__arrow lumu-slider__arrow--prev" onclick="lumuSlide(-1)">&#10094;</button>
    <button class="lumu-slider__arrow lumu-slider__arrow--next" onclick="lumuSlide(1)">&#10095;</button>

    <div class="lumu-slider__nav" id="LumuSliderNav">
      {%- for i in (1..slide_count) -%}
        <button class="lumu-slider__dot{% if forloop.first %} active{% endif %}" onclick="lumuGoTo({{ forloop.index0 }})"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    let current = 0;
    const total = {{ slide_count }};
    const track = document.getElementById('LumuSliderTrack');
    const dots = document.querySelectorAll('.lumu-slider__dot');

    function updateSlider() {
      if (!track) return;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    window.lumuSlide = function(dir) {
      current = (current + dir + total) % total;
      updateSlider();
    };

    window.lumuGoTo = function(idx) {
      current = idx;
      updateSlider();
    };

    {%- assign autoplay_speed = section.settings.autoplay_speed | default: 5 -%}
    setInterval(() => { window.lumuSlide(1); }, {{ autoplay_speed | times: 1000 }});
  })();
</script>

{% schema %}
{
  "name": "Lumu Hero Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your One-Stop Shop for Everything"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "From fashion to electronics, home essentials to beauty — shop 100+ categories with free delivery across the United States."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "secondary_button_label",
          "label": "Secondary Button Label (Optional)"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumu Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Your One-Stop Shop for <em>Everything</em>",
            "text": "From fashion to electronics, home essentials to beauty — shop 100+ categories with free delivery across the United States.",
            "button_label": "Shop Now",
            "secondary_button_label": "Browse Collections"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Latest Tech & Gadgets",
            "text": "Discover premium earbuds, smartwatches, chargers & more at prices you'll love. All 100% authentic.",
            "button_label": "Shop Electronics"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Transform Your Space",
            "text": "Premium home & kitchen essentials delivered to your door. Bedding, décor, cookware & more.",
            "button_label": "Shop Home",
            "secondary_button_label": "View All"
          }
        }
      ]
    }
  ]
}
{% endschema %}
