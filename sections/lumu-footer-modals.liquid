<link rel="stylesheet" href="{{ 'lumu-custom.css' | asset_url }}" media="print" onload="this.media='all'">

<div class="lumu-modals-wrapper">
  
  {%- comment -%} 1. About Lumu {%- endcomment -%}
  <div id="modal-about" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.about_title | default: "About Lumu" }}</h2>
      <div class="lumu-modal__body">
        {{ section.settings.about_body | default: "<p>Welcome to <strong>LUMU</strong> - a revolutionary, large-scale e-commerce marketplace tailored to the evolving needs of our consumers.</p><p>With an extensive range of over 30+ product categories, LUMU is designed to serve every segment of society. We believe in bridging the gap between affordability and quality through streamlined drop-shipping and sourcing across the United States.</p>" }}
      </div>
    </div>
  </div>

  {%- comment -%} 2. Contact Us {%- endcomment -%}
  <div id="modal-contact" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.contact_title | default: "Contact Us" }}</h2>
      <div class="lumu-modal__body">
        <p>We are always here to help you with your inquiries.</p>
        <p><strong>Email:</strong> {{ section.settings.contact_email | default: "support@lumu.com" }}</p>
        <p><strong>Working Hours:</strong> {{ section.settings.working_hours | default: "Monday to Saturday, 9:00 AM - 6:00 PM" }}</p>
      </div>
    </div>
  </div>

  {%- comment -%} 3. Careers {%- endcomment -%}
  <div id="modal-careers" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.careers_title | default: "Careers at Lumu" }}</h2>
      <div class="lumu-modal__body">
        <p>Join the e-commerce revolution! We are always on the lookout for bright, passionate talent to join our growing team.</p>
        <p>Send your resume and portfolio to <strong>{{ section.settings.careers_email | default: "careers@lumu.com" }}</strong>.</p>
      </div>
    </div>
  </div>

  {%- comment -%} 4. Press {%- endcomment -%}
  <div id="modal-press" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.press_title | default: "Press & Media" }}</h2>
      <div class="lumu-modal__body">
        <p>For all press releases, media inquiries, and public relations, please reach out directly to our dedicated media team.</p>
        <p><strong>Contact:</strong> {{ section.settings.press_email | default: "media@lumu.com" }}</p>
      </div>
    </div>
  </div>

  {%- comment -%} 5. Lumu Ability {%- endcomment -%}
  <div id="modal-ability" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.ability_title | default: "Lumu's Ability Program" }}</h2>
      <div class="lumu-modal__body">
        {{ section.settings.ability_body | default: "<p>At Lumu, we believe commerce should be inclusive. The Ability Program is dedicated to empowering differently-abled individuals by providing them seamless opportunities to sell and work within our ecosystem.</p>" }}
      </div>
    </div>
  </div>

  {%- comment -%} 6. FAQ {%- endcomment -%}
  <div id="modal-faq" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.faq_title | default: "Frequently Asked Questions" }}</h2>
      <div class="lumu-modal__body">
        {{ section.settings.faq_body | default: "<p><strong>Q: How long does shipping take?</strong><br>A: Standard shipping takes 3-5 business days across the United States.</p><p><strong>Q: Are my payments safe?</strong><br>A: Yes! Our checkout utilizes industry-leading encryption and verified payment gateways.</p>" }}
      </div>
    </div>
  </div>

  {%- comment -%} 7. Purchase Protection {%- endcomment -%}
  <div id="modal-protection" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.protection_title | default: "Purchase Protection" }}</h2>
      <div class="lumu-modal__body">
        {{ section.settings.protection_body | default: "<p>Shop with 100% confidence. If your item does not arrive within the promised timeframe or differs from the description, our <strong>Purchase Protection</strong> guarantees a full review and return/refund.</p>" }}
      </div>
    </div>
  </div>

  {%- comment -%} 8. Partner With Lumu {%- endcomment -%}
  <div id="modal-partner" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.partner_title | default: "Partner With Lumu" }}</h2>
      <div class="lumu-modal__body">
        <p>Are you a manufacturer, distributor, or logistics provider? Partner with the fastest-growing US marketplace today.</p>
        <p>Contact us at <strong>{{ section.settings.partner_email | default: "partners@lumu.com" }}</strong> to discuss integration.</p>
      </div>
    </div>
  </div>

  {%- comment -%} 9. Seller FAQ {%- endcomment -%}
  <div id="modal-seller-faq" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.seller_faq_title | default: "Seller FAQ" }}</h2>
      <div class="lumu-modal__body">
        {{ section.settings.seller_faq_body | default: "<p><strong>Q: What do I need to start selling?</strong><br>A: Valid business registration and a commitment to quality. Join our seller portal to register your inventory.</p>" }}
      </div>
    </div>
  </div>

  {%- comment -%} 10. Seller Terms {%- endcomment -%}
  <div id="modal-seller-terms" class="lumu-modal">
    <div class="lumu-modal__content">
      <button class="lumu-modal__close" aria-label="Close">&times;</button>
      <h2 class="lumu-modal__title">{{ section.settings.seller_terms_title | default: "Seller Terms & Conditions" }}</h2>
      <div class="lumu-modal__body">
        {{ section.settings.seller_terms_body | default: "<p>By registering as a merchant on Lumu, you agree to adhere strictly to our quality control guidelines, timely dispatch policies, and customer dispute resolution frameworks. Ensuring end-buyer satisfaction is our top mutual priority.</p>" }}
      </div>
    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Select all links that start with #modal-
    const modalLinks = document.querySelectorAll('a[href^="#modal-"]');
    const closeButtons = document.querySelectorAll('.lumu-modal__close');
    const modals = document.querySelectorAll('.lumu-modal');

    // Open Modal
    modalLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('href').substring(1);
        const targetModal = document.getElementById(targetId);
        if(targetModal) {
          targetModal.classList.add('is-open');
          document.body.style.overflow = 'hidden'; // Prevent background scrolling
        }
      });
    });

    // Close Modal via button
    closeButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        this.closest('.lumu-modal').classList.remove('is-open');
        document.body.style.overflow = 'auto';
      });
    });

    // Close Modal by clicking outside content
    window.addEventListener('click', function(e) {
      if(e.target.classList.contains('lumu-modal')) {
        e.target.classList.remove('is-open');
        document.body.style.overflow = 'auto';
      }
    });
  });
</script>

