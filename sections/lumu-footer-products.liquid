
<div class="lumu-pre-footer-products">
  <div class="lumu-pfp__inner">
    <div class="lumu-pfp__header">
      <h2 class="lumu-pfp__title">{{ section.settings.title | default: "Trending Now" }}</h2>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="lumu-pfp__shop-btn">
          {{ section.settings.button_label }}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      {%- endif -%}
    </div>
    <div class="lumu-pfp__grid">
      {%- assign selected_collection = section.settings.collection -%}
      {%- if selected_collection != blank -%}
        {%- assign products_list = collections[selected_collection].products -%}
      {%- else -%}
        {%- assign products_list = collections.all.products -%}
      {%- endif -%}

      {%- assign limit_count = section.settings.products_to_show | default: 4 -%}
      {%- assign offset_count = section.settings.products_offset | default: 0 -%}

      {%- if products_list.size > offset_count -%}
        {%- for product in products_list limit: limit_count offset: offset_count -%}
          <div class="lumu-pfp__card-wrapper" style="height: 100%;">
            <a href="{{ product.url }}" class="lumu-pfp__card">
              <div class="lumu-pfp__card-img-wrap">
                <span class="product-card__ribbon product-card__ribbon--limited">Limited Stock</span>
                {%- if product.featured_image != blank -%}
                  <img src="{{ product.featured_image | image_url: width: 600, height: 600, crop: 'center' }}" alt="{{ product.title | escape }}" class="lumu-pfp__card-img" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
                {%- else -%}
                  <div class="lumu-pfp__card-img" style="background:#f0f0f5;"></div>
                {%- endif -%}
              </div>
              
              <div class="lumu-pfp__card-body">
                <div class="lumu-pfp__reviews">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <span>(4.9)</span>
                </div>
                
                <div class="lumu-pfp__card-name">{{ product.title }}</div>
                
                <div class="lumu-pfp__card-price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price -%}
                    <s>{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>
                
                <div class="lumu-pfp__atc-btn">Add to Cart</div>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit_count) -%}
          <div class="lumu-pfp__card-wrapper" style="height: 100%;">
            <div class="lumu-pfp__card">
              <div class="lumu-pfp__card-img-wrap">
                <span class="product-card__ribbon product-card__ribbon--limited">Limited Stock</span>
                <div class="lumu-pfp__card-img" style="background:#f0f0f5;"></div>
              </div>
              <div class="lumu-pfp__card-body">
                <div class="lumu-pfp__reviews">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <span>(5.0)</span>
                </div>
                <div class="lumu-pfp__card-name">Lumu Premium Product {{ i }}</div>
                <div class="lumu-pfp__card-price">$49.99</div>
                <div class="lumu-pfp__atc-btn">Add to Cart</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lumu Footer Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "products_offset",
      "min": 0,
      "max": 12,
      "step": 1,
      "label": "Products offset",
      "default": 0
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Lumu Footer Products"
    }
  ]
}
{% endschema %}
