{% comment %}
  Renders social icons.
  Accepts:
  - class: {String} a class to be added to the <ul> element (optional).

  Usage:
  {% render 'social-icons',
    class: 'my-class'
  %}
{% endcomment %}

{%- liquid
  assign social_facebook = settings.social_facebook_link | default: "https://www.facebook.com/profile.php?id=61589395702816"
  assign social_instagram = settings.social_instagram_link | default: "https://www.instagram.com/aitch.global/"
  assign social_youtube = settings.social_youtube_link
  assign social_tiktok = settings.social_tiktok_link
  assign social_twitter = settings.social_twitter_link
  assign social_pinterest = settings.social_pinterest_link
  assign social_snapchat = settings.social_snapchat_link
  assign social_tumblr = settings.social_tumblr_link
  assign social_vimeo = settings.social_vimeo_link
-%}

<ul class="list-unstyled list-social{% if class %} {{ class}}{% endif %}" role="list">
  {%- if social_facebook != blank -%}
    <li class="list-social__item">
      <a href="{{ social_facebook }}" class="link list-social__link">
        <span class="svg-wrapper">
          {{- 'icon-facebook.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if social_instagram != blank -%}
    <li class="list-social__item">
      <a href="{{ social_instagram }}" class="link list-social__link">
